{
  "name": "@tofazzal/eslint-config",
  "version": "0.1.0",
  "description": "Neutral ESLint preset for Next.js + TypeScript + Tailwind: enforces one folder structure, functional style, clear names and Tailwind hygiene so garbage code cannot land.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "rules",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/run.js"
  },
  "keywords": [
    "eslint",
    "eslintconfig",
    "react",
    "nextjs",
    "typescript",
    "tailwind",
    "folder-structure",
    "architecture",
    "functional"
  ],
  "license": "MIT",
  "author": "Md Tofazzal Haque",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tofazzal-verbex/eslint-config.git"
  },
  "homepage": "https://github.com/tofazzal-verbex/eslint-config#readme",
  "bugs": {
    "url": "https://github.com/tofazzal-verbex/eslint-config/issues"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0",
    "typescript": ">=4.8.4",
    "tailwindcss": "^3.3.0 || ^4.1.17"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-better-tailwindcss": "^4.9.1",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.2"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "eslint": "^9.39.5",
    "react": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  }
}
